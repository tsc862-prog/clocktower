# Copy to .env (git-ignored). Every key is optional; without one the relay starts in play-only mode for that provider.
# Keys are read only by the relay and the runners, never printed, never sent to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HF_TOKEN=
# Local models through Ollama (free): the default URL when unset
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
# How many Claude runners take turns at once
RUNNER_CLAUDE_MAX=6
